# Порт сервера (Render подставит автоматически)
PORT=3001

# URL фронтенда на Netlify (для CORS)
FRONTEND_URL=https://твой-сайт.netlify.app

# Neon PostgreSQL connection string
# Получи на https://neon.tech → Project → Connection string
# Формат: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
